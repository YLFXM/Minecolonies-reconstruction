<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="300 220"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_sketch.png" size="100% 100%"/>

    <text id="title" size="280 12" pos="10 8" textalign="MIDDLE" color="black"
          label="Road Surveyor"/>
    <text id="selected" size="280 10" pos="10 21" textalign="MIDDLE" color="black"
          label="Selected: 0"/>

    <list id="roads" size="280 130" pos="10 34">
        <box size="100% 24" linewidth="1">
            <button id="select" size="20 18" pos="2 3"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
                    label="[ ]" color="black"/>
            <text id="roadName" size="230 10" pos="26 3" color="black"/>
            <text id="roadDetail" size="230 9" pos="26 13" color="black" textscale="0.8"/>
        </box>
    </list>

    <button id="selectAll" size="88 17" pos="8 168"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="Select All" color="black"/>
    <button id="clear" size="88 17" pos="104 168"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="Clear" color="black"/>
    <button id="close" size="88 17" pos="200 168"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="Close" color="black"/>

    <button id="release" size="136 17" pos="8 190"
            source="minecolonies:textures/gui/builderhut/builder_button_large.png"
            label="Release Plans" color="black"/>
    <button id="remove" size="136 17" pos="152 190"
            source="minecolonies:textures/gui/builderhut/builder_button_large.png"
            label="Remove Roads" color="black"/>
</window>
